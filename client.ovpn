client
dev tun
proto udp

# VPN server IP and port
remote 192.168.56.101 1194

resolv-retry infinite
nobind

# Persist settings across restarts
persist-key
persist-tun

# Certificates and keys (full paths)
ca /home/IQ/vpn/ca.crt
cert /home/IQ/vpn/client1.crt
key /home/IQ/vpn/client1.key
tls-auth /home/IQ/vpn/ta.key 1

# Encryption - must match server
data-ciphers AES-256-GCM:AES-128-GCM:CHACHA20-POLY1305

# Logging
verb 3
